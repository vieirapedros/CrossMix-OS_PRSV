+# Whole seconds since boot, from /proc/uptime (not affected by the clock being set by ntp).
+uptime_s() {
+    [ -r "$PROC/uptime" ] || return 1
+    read -r up _ <"$PROC/uptime" || return 1
+    up=${up%%.*}
+    case "$up" in
+        '' | *[!0-9]*) return 1 ;;
