+# background `sync` started by flush() ends while the shell sleeps, and with the busybox
+# ash `sleep` that returns at once, so a "240 s" probe lasted 15 s in the first field log.
+nap() {
+    start=$(uptime_s) || {
+        sleep "$1"
+        return 0
+    }
+    end=$((start + $1))
+    while now=$(uptime_s) && [ "$now" -lt "$end" ]; do
+        sleep 1
+    done
+    return 0
