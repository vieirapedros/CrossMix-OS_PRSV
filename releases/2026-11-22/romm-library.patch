+  check "nada foi gravado em Roms/" sh -c "[ -z \"\$(find '$SD/Roms' -type f)\" ]"
+  check "GameCube nao foi empurrado para a pasta NGC (Neo Geo Pocket Color)" sh -c "! grep -q '\"ngc\"' '$CFGF'"
