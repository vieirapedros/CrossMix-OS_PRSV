diff --git a/Apps/RomMLibrary/launch.sh b/Apps/RomMLibrary/launch.sh
new file mode 100755
index 00000000..bac2a61f
--- /dev/null
+++ b/Apps/RomMLibrary/launch.sh
@@ -0,0 +1,39 @@
+#!/bin/sh
+# RomM Library para JukaMix / CrossMix OS (aba Apps).
+# Navega e baixa jogos do seu servidor RomM (ex.: via Tailscale) direto para Roms/.
+
+ROMM_SDCARD=${ROMM_SDCARD:-/mnt/SDCARD}
+export ROMM_SDCARD
+
+APP_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
+[ -f "$APP_DIR/lib/common.sh" ] || APP_DIR="$ROMM_SDCARD/Apps/RomMLibrary"
+export APP_DIR
+
+# Rastro de inicializacao: se o app "nao abre", System/logs/romm_library.log mostra ate onde chegou.
+LOGF="$ROMM_SDCARD/System/logs/romm_library.log"
+mkdir -p "$ROMM_SDCARD/System/logs" 2>/dev/null
+printf '%s launch.sh iniciou (pid %s, dir %s)\n' "$(date '+%F %T')" "$$" "$APP_DIR" >>"$LOGF" 2>/dev/null
+exec 2>>"$LOGF"
+
+PATH="$ROMM_SDCARD/System/bin:$ROMM_SDCARD/System/usr/trimui/scripts:$PATH"
+LD_LIBRARY_PATH="$ROMM_SDCARD/System/lib:/usr/trimui/lib:$LD_LIBRARY_PATH"
+export PATH LD_LIBRARY_PATH
+
+for _lib in i18n common net platforms download screens; do
+  if [ -f "$APP_DIR/lib/$_lib.sh" ]; then
+    . "$APP_DIR/lib/$_lib.sh"
+  else
+    printf '%s faltando lib/%s.sh\n' "$(date '+%F %T')" "$_lib" >>"$LOGF" 2>/dev/null
+    "$ROMM_SDCARD/System/usr/trimui/scripts/infoscreen.sh" -m "RomM Library: arquivo faltando (lib/$_lib.sh)" -t 3 >/dev/null 2>&1
+    exit 1
+  fi
+done
+
+log_rotate
+trap cleanup EXIT
+trap 'exit 130' INT TERM HUP
+
+app_main
+_rc=$?
+log "launch.sh terminou (rc $_rc)"
+exit "$_rc"
diff --git a/Apps/RomMLibrary/lib/common.sh b/Apps/RomMLibrary/lib/common.sh
new file mode 100755
index 00000000..af1d40e9
--- /dev/null
+++ b/Apps/RomMLibrary/lib/common.sh
@@ -0,0 +1,169 @@
+#!/bin/sh
+# RomM Library - common.sh: caminhos, log, config e UI. Carregado por launch.sh.
+# Regras: POSIX sh (BusyBox ash), sem "local", sem arrays, sem /bin/bash.
+
+NL='
+'
+US=$(printf '\037')
+
+SDCARD=${ROMM_SDCARD:-/mnt/SDCARD}
+BIN_DIR="$SDCARD/System/bin"
+SCRIPTS_DIR="$SDCARD/System/usr/trimui/scripts"
+ROMS_DIR="$SDCARD/Roms"
+LOGS_DIR="$SDCARD/System/logs"
+DATA_DIR="$SDCARD/Data/romm"
+CFG="$DATA_DIR/config.json"
+LOG="$LOGS_DIR/romm_library.log"
+TS_BIN="$BIN_DIR/tailscale"
+SELECTOR="$BIN_DIR/selector"
+VKEYBOARD="$BIN_DIR/VirtualKeyboard"
+INFOSCREEN="$SCRIPTS_DIR/infoscreen.sh"
+
+TMPD="/tmp/rommlib.$$"
+STAY_AWAKE=""
+DL_PID=""
+
+pick_bin() { # nome... -> caminho do primeiro que existir (System/bin, depois PATH)
+  for _pb in "$@"; do
+    if [ -x "$BIN_DIR/$_pb" ]; then printf '%s' "$BIN_DIR/$_pb"; return 0; fi
+  done
+  for _pb in "$@"; do
+    _pp=$(command -v "$_pb" 2>/dev/null) && [ -n "$_pp" ] && { printf '%s' "$_pp"; return 0; }
+  done
+  return 1
+}
+JQ=$(pick_bin jq)
+CURL=$(pick_bin curl-aarch64 curl)
+SEVENZ=$(pick_bin 7zz 7z)
+
+# ---------------------------------------------------------------- log
+log() { printf '%s %s\n' "$(date '+%F %T')" "$*" >>"$LOG" 2>/dev/null; }
+
+log_rotate() {
+  [ -f "$LOG" ] || return 0
+  _lr=$(wc -c <"$LOG" 2>/dev/null | tr -d ' ')
+  [ "${_lr:-0}" -gt 262144 ] && mv -f "$LOG" "$LOG.1" 2>/dev/null
+  return 0
+}
+
+# ---------------------------------------------------------------- tmp / limpeza
+tmp_init() {
+  rm -rf "$TMPD"
+  (umask 077; mkdir -p "$TMPD")
+}
+
+cleanup() {
+  [ -n "$DL_PID" ] && kill "$DL_PID" 2>/dev/null
+  [ -n "$STAY_AWAKE" ] && rm -f /tmp/stay_awake
+  rm -rf "$TMPD"
+}
+
+# ---------------------------------------------------------------- utilidades
+fsize() {
+  [ -f "$1" ] || { printf '0'; return 0; }
+  _fs=$(wc -c <"$1" 2>/dev/null | tr -d ' ')
+  printf '%s' "${_fs:-0}"
+}
+
+fmt_size() { # bytes -> "12.3 MB"
+  awk -v b="${1:-0}" 'BEGIN{
+    if (b >= 1073741824) printf "%.2f GB", b/1073741824;
+    else if (b >= 1048576) printf "%.1f MB", b/1048576;
+    else if (b >= 1024) printf "%.0f KB", b/1024;
+    else printf "%d B", b }'
+}
+
+urlenc() { "$JQ" -rn --arg s "$1" '$s|@uri'; }
+
+# nome seguro para FAT/exFAT: sem / \ : * ? " < > | nem controles; sem ponto/espaco nas pontas
+dl_sanitize() {
+  _sn=$(printf '%s' "$1" | tr -d '\000-\037' | tr '\\/:*?"<>|' '_________' |
+    sed -e 's/^[. ]*//' -e 's/[. ]*$//')
+  [ -n "$_sn" ] || _sn="rom"
+  printf '%s' "$_sn"
+}
+
+free_kb() { df -Pk "$1" 2>/dev/null | awk 'NR==2{print $4}'; }
+
+# ---------------------------------------------------------------- config (json; valores sempre string)
+cfg_valid() { [ -s "$CFG" ] && "$JQ" -e 'type=="object"' "$CFG" >/dev/null 2>&1; }
+
+cfg_get() {
+  [ -f "$CFG" ] || return 0
+  "$JQ" -r --arg k "$1" '.[$k] // empty | tostring' "$CFG" 2>/dev/null
+}
+
+cfg_write() { # le o filtro jq em $@ e aplica de forma atomica
+  mkdir -p "$DATA_DIR" 2>/dev/null
+  [ -s "$CFG" ] || printf '{}\n' >"$CFG"
+  "$JQ" "$@" "$CFG" >"$CFG.new" 2>/dev/null && mv -f "$CFG.new" "$CFG"
+}
+
+cfg_set() { cfg_write --arg k "$1" --arg v "$2" '.[$k]=$v'; }
+
+map_get() { # chave -> pasta lembrada
+  [ -f "$CFG" ] || return 0
+  "$JQ" -r --arg k "$1" '(.platform_map // {})[$k] // empty' "$CFG" 2>/dev/null
+}
+map_set() { cfg_write --arg k "$1" --arg v "$2" '.platform_map[$k]=$v'; }
+map_clear() { cfg_write 'del(.platform_map)'; }
+
+load_settings() {
+  PAGE_SIZE=$(cfg_get page_size)
+  case "$PAGE_SIZE" in '' | *[!0-9]*) PAGE_SIZE=30 ;; esac
+  [ "$PAGE_SIZE" -lt 5 ] && PAGE_SIZE=30
+  [ "$PAGE_SIZE" -gt 100 ] && PAGE_SIZE=100
+  LANG_UI=$(cfg_get lang)
+  [ "$LANG_UI" = en ] || LANG_UI=pt
+  lang_load "$LANG_UI"
+  FONT_SIZE=$(cfg_get font_size)
+  case "$FONT_SIZE" in *[!0-9]*) FONT_SIZE="" ;; esac
+  INSECURE=$(cfg_get insecure)
+}
+
+# ---------------------------------------------------------------- UI (selector / infoscreen / VirtualKeyboard)
+# Textos podem conter "\n" literal ou quebra real: o infoscreen recebe quebra real, o selector "\n" literal.
+to_real_nl() { printf '%s' "$1" | awk '{ gsub(/\\n/, "\n"); print }'; }
+to_lit_nl() { printf '%s' "$1" | awk 'NR > 1 { printf "%s", "\\n" } { printf "%s", $0 }'; }
+
+ui_info() { # mostra o texto e segue (a imagem fica na tela)
+  "$INFOSCREEN" -m "$(to_real_nl "$1")" -fs "${2:-32}" >/dev/null 2>&1
+}
+
+ui_wait() { # texto [teclas] -> imprime a tecla pressionada
+  "$INFOSCREEN" -m "$(to_real_nl "$1")" -fs 30 -k "${2:-A B}" 2>/dev/null
+}
+
+ui_notice() { ui_wait "$1${NL}${NL}A: $L_OK" "A B" >/dev/null; }
+
+ui_confirm() { # texto -> 0 se A (sim)
+  _uk=$("$INFOSCREEN" -m "$(to_real_nl "$1")${NL}${NL}A: $L_YES      B: $L_NO" -fs 30 -k "A B" 2>/dev/null)
+  [ "$_uk" = A ]
+}
+
+ui_choose() { # titulo item... -> imprime o item escolhido (vazio = cancelou)
+  _ct=$(to_lit_nl "$1")
+  shift
+  if [ -n "$FONT_SIZE" ]; then
+    _co=$("$SELECTOR" -fs "$FONT_SIZE" -t "$_ct" -c "$@" 2>/dev/null | grep 'You selected')
+  else
+    _co=$("$SELECTOR" -t "$_ct" -c "$@" 2>/dev/null | grep 'You selected')
+  fi
+  _co=${_co#*You selected: }
+  [ "$_co" = "You selected:" ] && _co=""
+  printf '%s' "$_co"
+}
+
+ui_input() { # nome-do-fundo texto-inicial [pw] -> imprime o texto digitado (vazio = cancelou)
+  _ib="$APP_DIR/res/kb_$1_$LANG_UI.png"
+  [ -f "$_ib" ] || _ib="$SDCARD/trimui/res/crossmix-os/bg-plain.png"
+  if [ "$3" = pw ]; then
+    _ir=$("$VKEYBOARD" -i "$_ib" -p 2>/dev/null)
+  else
+    _ir=$("$VKEYBOARD" -i "$_ib" -t "$2" 2>/dev/null)
+  fi
+  printf '%s' "$_ir" | grep -o '\[VKStart\].*\[VKEnd\]' | sed -e 's/\[VKStart\]//' -e 's/\[VKEnd\]//'
+}
+
+# "1. texto" -> 1
+choice_num() { printf '%s' "${1%%. *}"; }
diff --git a/Apps/RomMLibrary/lib/download.sh b/Apps/RomMLibrary/lib/download.sh
new file mode 100755
index 00000000..89c4e6ad
--- /dev/null
+++ b/Apps/RomMLibrary/lib/download.sh
@@ -0,0 +1,276 @@
+#!/bin/sh
+# RomM Library - download.sh: baixa uma ROM para Roms/<pasta>, com retomada e verificacoes.
+#
+# rom_download id fs_name multi file_id tamanho pasta titulo
+#   retorno: 0 ok | 1 falhou | 2 parado pelo usuario.  Texto do resultado em DL_MSG.
+#
+# Enderecos tentados, em ordem (versoes diferentes do RomM expoem rotas diferentes):
+#   1) /api/roms/{id}/content/{arquivo}        (arquivo unico = o proprio arquivo; multi-arquivo = ZIP)
+#   2) /api/roms/download?rom_ids={id}&filename=...   (sempre um ZIP)
+#   3) /api/romsfiles/{file_id}/content/{arquivo}     (so arquivo unico)
+
+DL_MSG=""
+DL_RC=0
+DL_CODE=000
+DL_CANCELLED=""
+
+dl_lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }
+
+# Roda o curl em segundo plano e mostra o progresso; B para.
+dl_run() { # url parcial retomar(0|1) total titulo
+  _dr_url=$1
+  _dr_part=$2
+  _dr_total=$4
+  _dr_title=$5
+  _dr_opt=""
+  [ "$3" = 1 ] && _dr_opt="-C -"
+  : >"$TMPD/dlcode"
+  # shellcheck disable=SC2086
+  "$CURL" -sSf -L --max-redirs 3 --connect-timeout 10 --speed-limit 1024 --speed-time 60 \
+    -K "$AUTH_CFG" $CURL_EXTRA $RESOLVE_OPT $_dr_opt -o "$_dr_part" -w '%{http_code}' "$_dr_url" \
+    >"$TMPD/dlcode" 2>"$TMPD/dlerr" &
+  DL_PID=$!
+  DL_CANCELLED=""
+  _dr_t0=$(date +%s)
+  _dr_b0=$(fsize "$_dr_part")
+  while kill -0 "$DL_PID" 2>/dev/null; do
+    _dr_cur=$(fsize "$_dr_part")
+    _dr_dt=$(($(date +%s) - _dr_t0))
+    _dr_speed=""
+    if [ "$_dr_dt" -ge 2 ] && [ "$_dr_cur" -gt "$_dr_b0" ]; then
+      _dr_speed="  -  $(fmt_size $(((_dr_cur - _dr_b0) / _dr_dt)))/s"
+    fi
+    if [ "$_dr_total" -gt 0 ]; then
+      _dr_pct=$((_dr_cur * 100 / _dr_total))
+      [ "$_dr_pct" -gt 99 ] && _dr_pct=99
+      _dr_line="${_dr_pct}%   $(fmt_size "$_dr_cur") / $(fmt_size "$_dr_total")$_dr_speed"
+    else
+      _dr_line="$(fmt_size "$_dr_cur")$_dr_speed"
+    fi
+    _dr_k=$("$INFOSCREEN" -m "$L_DL_PROGRESS${NL}${NL}$_dr_title${NL}${NL}$_dr_line${NL}${NL}$L_DL_CANCEL_HINT" -fs 28 -k B -t 1 2>/dev/null)
+    if [ "$_dr_k" = B ]; then
+      DL_CANCELLED=1
+      kill "$DL_PID" 2>/dev/null
+      break
+    fi
+  done
+  wait "$DL_PID" 2>/dev/null
+  DL_RC=$?
+  DL_PID=""
+  DL_CODE=$(cat "$TMPD/dlcode" 2>/dev/null)
+  [ -n "$DL_CODE" ] || DL_CODE=000
+  log "download id=$_dr_url -> http $DL_CODE rc $DL_RC bytes $(fsize "$_dr_part")"
+}
+
+dl_flatten_ok() { # dir pasta -> 0 se o dir contem arquivo com extensao aceita pelo emulador da pasta
+  _fl_ex=$("$JQ" -r '.extlist // empty' "$SDCARD/Emus/$2/config.json" 2>/dev/null)
+  [ -n "$_fl_ex" ] || return 1
+  _fl_ex=$(dl_lower "$_fl_ex")
+  for _fl_f in "$1"/*; do
+    [ -f "$_fl_f" ] || continue
+    _fl_e=$(dl_lower "${_fl_f##*.}")
+    case "|$_fl_ex|" in *"|$_fl_e|"*) return 0 ;; esac
+  done
+  return 1
+}
+
+dl_move_into() { # origem destino: move tudo (inclusive ocultos), sobrescrevendo
+  for _mv_f in "$1"/* "$1"/.[!.]*; do
+    [ -e "$_mv_f" ] || continue
+    _mv_t="$2/$(basename "$_mv_f")"
+    [ -d "$_mv_f" ] && [ -d "$_mv_t" ] && rm -rf "$_mv_t"
+    mv -f "$_mv_f" "$2/" || return 1
+  done
+  return 0
+}
+
+dl_extract() { # zip pasta-destino pasta-rom id [nome-final-se-arquivo-unico]
+  [ -n "$SEVENZ" ] || return 1
+  _ex_tmp="$2/.romm_extract_$4"
+  rm -rf "$_ex_tmp"
+  mkdir -p "$_ex_tmp" || return 1
+  "$SEVENZ" x -y -o"$_ex_tmp" "$1" >/dev/null 2>&1 || {
+    log "7zz falhou em $1"
+    rm -rf "$_ex_tmp"
+    return 1
+  }
+  _ex_n=0
+  _ex_one=""
+  for _ex_f in "$_ex_tmp"/* "$_ex_tmp"/.[!.]*; do
+    [ -e "$_ex_f" ] || continue
+    _ex_n=$((_ex_n + 1))
+    _ex_one=$_ex_f
+  done
+  # arquivo unico entregue dentro de um ZIP (rota /api/roms/download): grava com o nome ja sanitizado
+  if [ -n "$5" ] && [ "$_ex_n" = 1 ] && [ -f "$_ex_one" ]; then
+    mv -f "$_ex_one" "$2/$5" || { rm -rf "$_ex_tmp"; return 1; }
+    rm -rf "$_ex_tmp"
+    return 0
+  fi
+  _ex_src=$_ex_tmp
+  if [ "$_ex_n" = 1 ] && [ -d "$_ex_one" ] && dl_flatten_ok "$_ex_one" "$3"; then
+    _ex_src=$_ex_one
+  fi
+  dl_move_into "$_ex_src" "$2" || { rm -rf "$_ex_tmp"; return 1; }
+  rm -rf "$_ex_tmp"
+  return 0
+}
+
+rom_download() {
+  _id=$1
+  _fs=$2
+  _multi=$3
+  _fid=$4
+  _size=$5
+  _folder=$6
+  _title=$7
+  case "$_size" in '' | *[!0-9]*) _size=0 ;; esac
+  [ "$_fid" = - ] && _fid=""
+  [ "$_fs" = - ] && _fs="rom_$_id"
+  DL_MSG=""
+  _dir="$ROMS_DIR/$_folder"
+  mkdir -p "$_dir" 2>/dev/null || { DL_MSG="$L_DL_FAILED ($_dir)"; return 1; }
+  _clean=$(dl_sanitize "$_fs")
+
+  _need=$_size
+  [ "$_multi" = 1 ] && _need=$((_size * 2))
+  if [ "$_need" -gt 0 ]; then
+    _free=$(free_kb "$_dir")
+    case "$_free" in
+    '' | *[!0-9]*) : ;;
+    *) if [ $((_free * 1024)) -lt $((_need + 8388608)) ]; then DL_MSG="$L_DL_NOSPACE"; return 1; fi ;;
+    esac
+  fi
+
+  _enc=$(urlenc "$_fs")
+  _path1="/api/roms/$_id/content/$_enc"
+  _path2="/api/roms/download?rom_ids=$_id&filename=$_enc"
+  _path3=""
+  [ -n "$_fid" ] && [ "$_multi" != 1 ] && _path3="/api/romsfiles/$_fid/content/$_enc"
+  if [ "$_multi" = 1 ]; then _kind1=zip; else _kind1=raw; fi
+
+  _state="$_dir/.romm_$_id.state"
+  _start=1
+  if [ -f "$_state" ]; then
+    _start=$(cat "$_state" 2>/dev/null)
+    case "$_start" in 1 | 2 | 3) : ;; *) _start=1 ;; esac
+  fi
+  _order="$_start"
+  for _o in 1 2 3; do [ "$_o" != "$_start" ] && _order="$_order $_o"; done
+
+  echo 1 >/tmp/stay_awake 2>/dev/null && STAY_AWAKE=1
+  ui_info "$L_DL_STARTING"
+
+  _ok=""
+  _stop=""
+  for _i in $_order; do
+    case "$_i" in
+    1) _path=$_path1; _kind=$_kind1 ;;
+    2) _path=$_path2; _kind=zip ;;
+    3) _path=$_path3; _kind=raw ;;
+    esac
+    [ -n "$_path" ] || continue
+    if [ "$_kind" = zip ]; then _part="$_dir/$_clean.zip.rommpart"; else _part="$_dir/$_clean.rommpart"; fi
+
+    _resume=0
+    if [ -s "$_part" ] && [ "$_i" = "$_start" ] && [ -f "$_state" ]; then _resume=1; else rm -f "$_part"; fi
+    echo "$_i" >"$_state"
+
+    _tries=0
+    while [ "$_tries" -lt 2 ]; do
+      _tries=$((_tries + 1))
+      dl_run "$NET_BASE$_path" "$_part" "$_resume" "$_size" "$_title"
+      if [ -n "$DL_CANCELLED" ]; then
+        _stop=cancel
+        break 2
+      fi
+      if [ "$DL_RC" = 0 ] && { [ "$DL_CODE" = 200 ] || [ "$DL_CODE" = 206 ]; }; then
+        _ok=$_i
+        break 2
+      fi
+      # servidor sem suporte a Range, ou arquivo mudou: recomeca do zero uma vez
+      if [ "$_resume" = 1 ] && { [ "$DL_RC" = 33 ] || [ "$DL_CODE" = 416 ]; }; then
+        rm -f "$_part"
+        _resume=0
+        continue
+      fi
+      break
+    done
+
+    case "$DL_CODE" in
+    401 | 403)
+      DL_MSG="$L_E_AUTH"
+      _stop=fail
+      break
+      ;;
+    esac
+    case "$DL_RC" in
+    6 | 7 | 18 | 28 | 52 | 55 | 56)
+      DL_MSG="$L_DL_INTERRUPTED"
+      _stop=fail
+      break
+      ;;
+    esac
+    rm -f "$_part"
+  done
+
+  if [ -n "$STAY_AWAKE" ]; then rm -f /tmp/stay_awake; STAY_AWAKE=""; fi
+
+  if [ "$_stop" = cancel ]; then
+    DL_MSG="$L_DL_CANCELLED"
+    return 2
+  fi
+  if [ -z "$_ok" ]; then
+    if [ -z "$_stop" ]; then
+      rm -f "$_state"
+      DL_MSG="$L_DL_NOTFOUND (HTTP $DL_CODE)"
+    fi
+    [ -n "$DL_MSG" ] || DL_MSG="$L_DL_FAILED"
+    return 1
+  fi
+
+  # ---- sucesso no curl: confere, move/extrai, limpa
+  if [ "$_kind" = zip ]; then
+    ui_info "$L_DL_EXTRACT"
+    _single=""
+    [ "$_multi" = 1 ] || _single=$_clean
+    if ! dl_extract "$_part" "$_dir" "$_folder" "$_id" "$_single"; then
+      rm -f "$_part" "$_state"
+      DL_MSG="$L_DL_EXTRACT_FAIL"
+      return 1
+    fi
+    rm -f "$_part"
+    _shown="$_clean"
+  else
+    if [ "$_size" -gt 0 ] && [ "$(fsize "$_part")" -lt "$_size" ]; then
+      DL_MSG="$L_DL_SIZE_BAD"
+      return 1
+    fi
+    if [ "$(fsize "$_part")" -le 0 ]; then
+      rm -f "$_part" "$_state"
+      DL_MSG="$L_DL_FAILED"
+      return 1
+    fi
+    mv -f "$_part" "$_dir/$_clean" || { DL_MSG="$L_DL_FAILED"; return 1; }
+    _shown="$_clean"
+  fi
+  rm -f "$_state"
+  rm -f "$_dir"/*_cache*.db 2>/dev/null
+  sync
+  DL_FINAL="$_dir/$_clean"
+  DL_MSG="$L_DL_OK Roms/$_folder/${NL}$_shown${NL}${NL}$L_DL_OK2"
+  log "download ok: id=$_id -> Roms/$_folder/$_shown"
+  return 0
+}
+
+dl_clean_parts() { # apaga restos de downloads incompletos; imprime quantos
+  _cp_n=0
+  for _cp_d in "$ROMS_DIR"/*; do
+    [ -d "$_cp_d" ] || continue
+    for _cp_f in "$_cp_d"/*.rommpart "$_cp_d"/.romm_*.state "$_cp_d"/.romm_extract_*; do
+      [ -e "$_cp_f" ] || continue
+      rm -rf "$_cp_f" && _cp_n=$((_cp_n + 1))
+    done
+  done
+  printf '%s' "$_cp_n"
+}
