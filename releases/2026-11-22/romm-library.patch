+++ b/tests/romm_library/mocks/7zz
@@ -0,0 +1,6 @@
+#!/bin/sh
+# mock do 7zz (so a interface "x -y -o<dir> arquivo"), usando python
+[ "$1" = x ] || exit 2
+out=""; src=""
+for a in "$@"; do case "$a" in -o*) out=${a#-o} ;; x | -y) ;; *) src=$a ;; esac; done
+exec python3 -I -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])' "$src" "$out"
