+
+if scenario "e2e-search-global"; then
+  start_server; new_sd
+  write_cfg "{\"base_url\":\"http://127.0.0.1:$PORT\",\"token\":\"$TOKEN\",\"platform_map\":{\"arcade\":\"FBNEO\"}}"
