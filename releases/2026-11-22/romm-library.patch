+    L_TS_DOWN="O Tailscale não está conectado: System Tools > NETWORK > Tailscale."
+    L_TS_UP="Tailscale: conectado"
+    L_ABOUT_LOG="Log"
+    L_ABOUT_CFG="Config"
+    L_ABOUT_SRV="Versão do servidor"
+    ;;
+  esac
+}
diff --git a/Apps/RomMLibrary/lib/net.sh b/Apps/RomMLibrary/lib/net.sh
new file mode 100755
index 00000000..8252cbc0
--- /dev/null
+++ b/Apps/RomMLibrary/lib/net.sh
@@ -0,0 +1,313 @@
+#!/bin/sh
+# RomM Library - net.sh: acesso a API do RomM (curl), Tailscale e diagnostico.
+
+NET_BASE=""
+NET_SCHEME=""
+NET_HOST=""
+NET_PORT=""
+NET_ERR=""
+NET_VERSION=""
+AUTH_CFG=""
+RESOLVE_OPT=""
+CURL_EXTRA=""
+API_CODE=000
+API_RC=0
+OAUTH_DONE=""
+CONNECT_TO=${ROMM_CONNECT_TIMEOUT:-8}
+MAX_TIME=${ROMM_MAX_TIME:-45}
+
+net_normalize_url() { # "nas:8080/" -> "http://nas:8080"; falha se nao sobrar host
+  _nu=$(printf '%s' "$1" | tr -d ' \t\r\n')
+  [ -n "$_nu" ] || return 1
+  case "$_nu" in
+  [Hh][Tt][Tt][Pp]://* | [Hh][Tt][Tt][Pp][Ss]://*)
+    _ns=$(printf '%s' "${_nu%%://*}" | tr 'A-Z' 'a-z')
+    _nr=${_nu#*://}
+    ;;
+  *)
+    _ns=http
+    _nr=$_nu
+    ;;
+  esac
+  while :; do
+    case "$_nr" in */) _nr=${_nr%/} ;; *) break ;; esac
+  done
+  case "$_nr" in */api) _nr=${_nr%/api} ;; esac
+  case "$_nr" in '' | /* | :*) return 1 ;; esac
+  printf '%s://%s' "$_ns" "$_nr"
+}
+
+net_parts() { # define NET_SCHEME NET_HOST NET_PORT a partir de NET_BASE
+  NET_SCHEME=${NET_BASE%%://*}
+  _np=${NET_BASE#*://}
+  _np=${_np%%/*}
+  case "$_np" in
+  *:*)
+    NET_HOST=${_np%%:*}
+    NET_PORT=${_np#*:}
+    ;;
+  *)
+    NET_HOST=$_np
+    if [ "$NET_SCHEME" = https ]; then NET_PORT=443; else NET_PORT=80; fi
+    ;;
+  esac
+}
+
+curlcfg_esc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
+
+net_write_auth() { # grava o arquivo de credenciais do curl (em /tmp; nunca em argv nem no log)
+  AUTH_CFG="$TMPD/auth.cfg"
+  : >"$AUTH_CFG"
+  _tok=$(cfg_get token)
+  _usr=$(cfg_get username)
+  _pw=$(cfg_get password)
+  if [ -n "$_tok" ]; then
+    printf 'header = "Authorization: Bearer %s"\n' "$(curlcfg_esc "$_tok")" >"$AUTH_CFG"
+  elif [ -n "$_usr" ]; then
+    printf 'user = "%s:%s"\nbasic\n' "$(curlcfg_esc "$_usr")" "$(curlcfg_esc "$_pw")" >"$AUTH_CFG"
+  fi
+}
+
+net_init() {
+  NET_BASE=$(cfg_get base_url)
+  net_parts
+  RESOLVE_OPT=""
+  OAUTH_DONE=""
+  CURL_EXTRA=""
+  [ "$(cfg_get insecure)" = 1 ] && CURL_EXTRA="-k"
+  net_write_auth
+}
+
+# ---------------------------------------------------------------- Tailscale
+ts_state() { # imprime: absent | stopped | running <ip>
+  [ -x "$TS_BIN" ] || { printf 'absent'; return 0; }
+  _tj=$("$TS_BIN" status --json 2>/dev/null) || { printf 'stopped'; return 0; }
+  _ts=$(printf '%s' "$_tj" | "$JQ" -r '.BackendState // empty' 2>/dev/null)
+  if [ "$_ts" = Running ]; then
+    printf 'running %s' "$(printf '%s' "$_tj" | "$JQ" -r '.Self.TailscaleIPs[0] // empty' 2>/dev/null)"
+  else
+    printf 'stopped'
+  fi
+}
+
+host_is_tailnet() {
+  case "$NET_HOST" in
+  100.6[4-9].* | 100.[7-9][0-9].* | 100.1[01][0-9].* | 100.12[0-7].* | *.ts.net) return 0 ;;
+  esac
+  return 1
+}
+
+ts_hint() { # texto de dica, se fizer sentido, em $TS_HINT
+  TS_HINT=""
+  _th=$(ts_state)
+  case "$_th" in
+  absent) host_is_tailnet && TS_HINT="$L_TS_ABSENT" ;;
+  running*) : ;;
+  *) TS_HINT="$L_TS_DOWN" ;;
+  esac
+}
+
+ts_resolve() { # MagicDNS pode nao resolver no aparelho: pergunta o IP ao proprio Tailscale
+  [ -x "$TS_BIN" ] || return 1
+  [ -z "$RESOLVE_OPT" ] || return 1
+  _tn=${NET_HOST%%.*}
+  _ti=$("$TS_BIN" ip -4 "$_tn" 2>/dev/null | head -n 1)
+  case "$_ti" in
+  [0-9]*.[0-9]*.[0-9]*.[0-9]*)
+    RESOLVE_OPT="--resolve $NET_HOST:$NET_PORT:$_ti"
+    log "dns: $NET_HOST resolvido via tailscale"
+    return 0
+    ;;
+  esac
+  return 1
+}
+
+# ---------------------------------------------------------------- requisicoes
+api_curl() { # saida url [args...]  -> API_RC, API_CODE
+  _ao=$1
+  _au=$2
+  shift 2
+  # shellcheck disable=SC2086
+  "$CURL" -sS -L --max-redirs 3 --connect-timeout "$CONNECT_TO" --max-time "$MAX_TIME" \
+    --retry 2 --retry-delay 1 -K "$AUTH_CFG" $CURL_EXTRA $RESOLVE_OPT "$@" \
+    -o "$_ao" -w '%{http_code}' "$_au" >"$TMPD/code" 2>"$TMPD/curl.err"
+  API_RC=$?
+  API_CODE=$(cat "$TMPD/code" 2>/dev/null)
+  [ -n "$API_CODE" ] || API_CODE=000
+  if [ "$API_RC" = 6 ] && ts_resolve; then
+    api_curl "$_ao" "$_au" "$@"
+    return
+  fi
+  if [ "$API_CODE" = 401 ] && [ -z "$OAUTH_DONE" ] && net_oauth_login; then
+    api_curl "$_ao" "$_au" "$@"
+    return
+  fi
+  log "GET ${_au#"$NET_BASE"} -> http $API_CODE rc $API_RC"
+}
+
+api_get() { # saida caminho [chave=valor ...]
+  _go=$1
+  _gp=$2
+  shift 2
+  _gn=$#
+  while [ "$_gn" -gt 0 ]; do
+    set -- "$@" --data-urlencode "$1"
+    shift
+    _gn=$((_gn - 1))
+  done
+  api_curl "$_go" "$NET_BASE$_gp" -G "$@"
+}
+
+# Alguns servidores recusam Basic: tenta o login OAuth2 (password grant) uma vez por sessao.
+net_oauth_login() {
+  OAUTH_DONE=1
+  [ -z "$(cfg_get token)" ] || return 1
+  _ou=$(cfg_get username)
+  _op=$(cfg_get password)
+  [ -n "$_ou" ] || return 1
+  # shellcheck disable=SC2086
+  "$CURL" -sS --connect-timeout "$CONNECT_TO" --max-time 20 $CURL_EXTRA $RESOLVE_OPT \
+    --data-urlencode "grant_type=password" --data-urlencode "username=$_ou" \
+    --data-urlencode "password=$_op" \
+    --data-urlencode "scope=me.read roms.read platforms.read assets.read firmware.read collections.read" \
+    -o "$TMPD/oauth.json" "$NET_BASE/api/token" >/dev/null 2>&1 || return 1
+  _oa=$("$JQ" -r '.access_token // empty' "$TMPD/oauth.json" 2>/dev/null)
+  [ -n "$_oa" ] || return 1
+  printf 'header = "Authorization: Bearer %s"\n' "$(curlcfg_esc "$_oa")" >"$AUTH_CFG"
+  log "auth: Basic recusado; usando token OAuth da sessao"
+  return 0
+}
+
+# ---------------------------------------------------------------- diagnostico
+net_explain() { # rc code -> NET_ERR (+ dica do Tailscale)
+  case "$1" in
+  0)
+    case "$2" in
+    401 | 403) NET_ERR="$L_E_AUTH" ;;
+    404 | 405) NET_ERR="$L_E_NOTROMM" ;;
+    5??) NET_ERR="$L_E_SERVER $2." ;;
+    *) NET_ERR="$L_E_OTHER (HTTP $2)." ;;
+    esac
+    ;;
+  6) NET_ERR="$L_E_DNS" ;;
+  7) NET_ERR="$L_E_REFUSED" ;;
+  28) NET_ERR="$L_E_TIMEOUT" ;;
+  35 | 51 | 58 | 59 | 60 | 77 | 83) NET_ERR="$L_E_TLS" ;;
+  *) NET_ERR="$L_E_OTHER (curl $1, HTTP $2)." ;;
+  esac
+  case "$1" in
+  6 | 7 | 28)
+    ts_hint
+    [ -n "$TS_HINT" ] && NET_ERR="$NET_ERR$NL$TS_HINT"
+    ;;
+  *)
+    if host_is_tailnet; then
+      ts_hint
+      [ -n "$TS_HINT" ] && NET_ERR="$NET_ERR$NL$TS_HINT"
+    fi
+    ;;
+  esac
+  return 0
+}
+
+# ---------------------------------------------------------------- operacoes de alto nivel
+net_connect() { # testa servidor + login e carrega as plataformas. 0 = ok; senao NET_ERR
+  NET_ERR=""
+  NET_VERSION=""
+  api_get "$TMPD/heartbeat.json" /api/heartbeat
+  if [ "$API_RC" != 0 ] || [ "$API_CODE" != 200 ]; then
+    net_explain "$API_RC" "$API_CODE"
+    return 1
+  fi
+  NET_VERSION=$("$JQ" -r '.SYSTEM.VERSION // empty' "$TMPD/heartbeat.json" 2>/dev/null)
+  if [ -z "$NET_VERSION" ] && ! "$JQ" -e 'type=="object"' "$TMPD/heartbeat.json" >/dev/null 2>&1; then
+    net_explain 0 404
+    return 1
+  fi
+  fetch_platforms || return 1
+  return 0
+}
+
+fetch_platforms() { # /api/platforms -> $TMPD/platforms.tsv (id, nome, qtd, slug, fs_slug)
+  api_get "$TMPD/platforms.json" /api/platforms
+  if [ "$API_RC" != 0 ] || [ "$API_CODE" != 200 ]; then
+    net_explain "$API_RC" "$API_CODE"
+    return 1
+  fi
+  "$JQ" -r '
+    def s: if . == null or . == "" then "-" else (tostring | gsub("[\u001f\t\r\n]"; " ") | gsub("^ +| +$"; "")) end;
+    (if type == "array" then . else (.items // .platforms // []) end)
+    | map(select((.rom_count // 1) > 0))
+    | sort_by(((.display_name // .custom_name // .name // .slug // "") | ascii_downcase))
+    | .[]
+    | [ (.id | s), ((.display_name // .custom_name // .name // .slug) | s), (.rom_count | s),
+        (.slug | s), (.fs_slug | s) ]
+    | join("\u001f")' "$TMPD/platforms.json" >"$TMPD/platforms.tsv" 2>>"$LOG"
+  if ! [ -f "$TMPD/platforms.tsv" ]; then
+    NET_ERR="$L_E_OTHER (JSON)."
+    log "platforms: resposta inesperada: $(head -c 300 "$TMPD/platforms.json" 2>/dev/null)"
+    return 1
+  fi
+  PLATFORM_COUNT=$(wc -l <"$TMPD/platforms.tsv" | tr -d ' ')
+  return 0
+}
+
+# Pagina de ROMs. platform_id e busca podem ser vazios.
+# Saida: $TMPD/page.tsv (1 jogo por linha), $TMPD/letters.tsv, e as variaveis ROMS_COUNT / ROMS_TOTAL / ROMS_HASNEXT.
+roms_page() { # platform_id busca offset limite
+  _rp=$1
+  _rq=$2
+  _ro=$3
+  _rl=$4
+  set -- "limit=$_rl" "offset=$_ro" "order_by=name" "order_dir=asc" "with_char_index=true"
+  [ -n "$_rp" ] && set -- "$@" "platform_ids=$_rp" "platform_id=$_rp"
+  [ -n "$_rq" ] && set -- "$@" "search_term=$_rq"
+  api_get "$TMPD/roms.json" /api/roms "$@"
+  if [ "$API_RC" != 0 ] || [ "$API_CODE" != 200 ]; then
+    net_explain "$API_RC" "$API_CODE"
+    return 1
+  fi
+  "$JQ" -r --argjson off "$_ro" --argjson lim "$_rl" '
+    def s: if . == null or . == "" then "-" else (tostring | gsub("[\u001f\t\r\n]"; " ") | gsub("^ +| +$"; "")) end;
+    def items: if type == "array" then . else (.items // .roms // .results // []) end;
+    (if type == "array" then items | .[$off:$off + $lim] else items end)
+    | .[]
+    | [ (.id | s),
+        ((.name // .fs_name_no_ext // .fs_name) | s),
+        ((.fs_size_bytes // .file_size_bytes // 0) | s),
+        (.fs_name | s),
+        ((if ((.has_multiple_files // .multi // false) or ((.files // []) | length > 1)) then 1 else 0 end) | s),
+        ((.files // [])[0].id | s),
+        (.platform_id | s),
+        (.platform_slug | s),
+        (.platform_fs_slug | s),
+        ((.platform_display_name // .platform_name) | s),
+        (((.regions // []) | join(",")) | s) ]
+    | join("\u001f")' "$TMPD/roms.json" >"$TMPD/page.tsv" 2>>"$LOG"
+  if ! [ -f "$TMPD/page.tsv" ]; then
+    NET_ERR="$L_E_OTHER (JSON)."
+    log "roms: resposta inesperada: $(head -c 300 "$TMPD/roms.json" 2>/dev/null)"
+    return 1
+  fi
+  "$JQ" -r --argjson off "$_ro" --argjson lim "$_rl" '
+    def items: if type == "array" then . else (.items // .roms // .results // []) end;
+    (if type == "array" then (items | .[$off:$off + $lim] | length) else (items | length) end) as $count
+    | (if type == "array" then length else (.total // null) end) as $total
+    | "\($count)\u001f\($total // "-")"' "$TMPD/roms.json" >"$TMPD/page.meta" 2>/dev/null
+  IFS=$US read -r ROMS_COUNT ROMS_TOTAL <"$TMPD/page.meta"
+  case "$ROMS_COUNT" in '' | *[!0-9]*) ROMS_COUNT=$(wc -l <"$TMPD/page.tsv" | tr -d ' ') ;; esac
+  case "$ROMS_TOTAL" in '' | *[!0-9]*) ROMS_TOTAL="" ;; esac
+  if [ -n "$ROMS_TOTAL" ]; then
+    # total conhecido (envelope, ou array legado): ha proxima pagina se ainda faltar
+    if [ $((_ro + ROMS_COUNT)) -lt "$ROMS_TOTAL" ]; then ROMS_HASNEXT=1; else ROMS_HASNEXT=0; fi
+  elif [ "$ROMS_COUNT" -ge "$_rl" ]; then
+    ROMS_HASNEXT=1
+  else
+    ROMS_HASNEXT=0
+  fi
+  "$JQ" -r '
+    (if type == "object" then (.char_index // {}) else {} end)
+    | to_entries | map(select(.value | type == "number")) | sort_by(.value)
+    | .[] | "\(.key)\u001f\(.value)"' "$TMPD/roms.json" >"$TMPD/letters.tsv" 2>/dev/null
+  return 0
+}
diff --git a/Apps/RomMLibrary/lib/platforms.sh b/Apps/RomMLibrary/lib/platforms.sh
new file mode 100755
index 00000000..8df61ae6
--- /dev/null
+++ b/Apps/RomMLibrary/lib/platforms.sh
@@ -0,0 +1,46 @@
+#!/bin/sh
+# RomM Library - platforms.sh: plataforma do RomM -> pasta de Roms/ do CrossMix/JukaMix.
+# Ordem: 1) pasta lembrada no config.json  2) data/platform_map.tsv  3) pergunta ao usuario e lembra.
+
+plat_norm() { printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9'; }
+
+plat_key() { # pid slug fs_slug -> chave estavel para lembrar a escolha
+  if [ -n "$3" ]; then printf '%s' "$3"; elif [ -n "$2" ]; then printf '%s' "$2"; else printf 'id%s' "$1"; fi
+}
+
+plat_builtin() { # slug fs_slug -> pasta (ou nada)
+  for _pk in "$2" "$1"; do
+    _pn=$(plat_norm "$_pk")
+    [ -n "$_pn" ] || continue
+    _pf=$(awk -F'\t' -v k="$_pn" '!/^#/ && $1 == k { print $2; exit }' "$APP_DIR/data/platform_map.tsv")
+    if [ -n "$_pf" ]; then printf '%s' "$_pf"; return 0; fi
+  done
+  return 1
+}
+
+plat_folder() { # pid slug fs_slug -> pasta ou vazio (nao pergunta nada)
+  _pm=$(map_get "$(plat_key "$1" "$2" "$3")")
+  if [ -n "$_pm" ]; then printf '%s' "$_pm"; return 0; fi
+  plat_builtin "$2" "$3"
+}
+
+plat_ask_folder() { # pid slug fs_slug -> pasta escolhida (lembrada) ou vazio
+  _pak=$(plat_key "$1" "$2" "$3") # antes do "set --" abaixo, que sobrescreve $1 $2 $3
+  _pa="$TMPD/roms_dirs.txt"
+  : >"$_pa"
+  for _pd in "$ROMS_DIR"/*; do
+    [ -d "$_pd" ] || continue
+    basename "$_pd" >>"$_pa"
+  done
+  set --
+  while IFS= read -r _pl; do
+    [ -n "$_pl" ] && set -- "$@" "$_pl"
+  done <"$_pa"
+  [ "$#" -gt 0 ] || return 1
+  _pc=$(ui_choose "$L_ASK_FOLDER" "$@")
+  [ -n "$_pc" ] || return 1
+  [ -d "$ROMS_DIR/$_pc" ] || return 1
+  map_set "$_pak" "$_pc"
+  log "mapeamento: $_pak -> $_pc"
+  printf '%s' "$_pc"
+}
diff --git a/Apps/RomMLibrary/lib/screens.sh b/Apps/RomMLibrary/lib/screens.sh
new file mode 100755
index 00000000..1832a8b4
--- /dev/null
+++ b/Apps/RomMLibrary/lib/screens.sh
@@ -0,0 +1,371 @@
+#!/bin/sh
+# RomM Library - screens.sh: telas (assistente, menus, lista de jogos, detalhe, configuracoes).
+
+APP_VERSION="1.0.0"
+
+# ---------------------------------------------------------------- linhas das tabelas
+row_load() { # n -> R_* (a partir de $TMPD/page.tsv)
+  awk -v n="$1" 'NR == n { print; exit }' "$TMPD/page.tsv" >"$TMPD/row.txt"
+  IFS=$US read -r R_ID R_NAME R_SIZE R_FS R_MULTI R_FID R_PID R_PSLUG R_PFS R_PNAME R_REG <"$TMPD/row.txt"
+  for _rv in R_PID R_PSLUG R_PFS R_PNAME R_REG; do
+    eval "[ \"\$$_rv\" = - ] && $_rv=''"
+  done
+  [ "$R_SIZE" = - ] && R_SIZE=0
+  return 0
+}
+
+plat_name_by_id() {
+  awk -F"$US" -v id="$1" '$1 == id { print $2; exit }' "$TMPD/platforms.tsv" 2>/dev/null
+}
+
+# ---------------------------------------------------------------- detalhe do jogo
+screen_game() { # usa R_*
+  _sg_folder=$(plat_folder "$R_PID" "$R_PSLUG" "$R_PFS")
+  _sg_pname=$R_PNAME
+  [ -n "$_sg_pname" ] || _sg_pname=$(plat_name_by_id "$R_PID")
+  while :; do
+    _sg_ex=""
+    if [ -n "$_sg_folder" ] && [ "$R_MULTI" != 1 ] && [ "$R_FS" != - ] &&
+      [ -f "$ROMS_DIR/$_sg_folder/$(dl_sanitize "$R_FS")" ]; then
+      _sg_ex=1
+    fi
+    _sg_l2=$_sg_pname
+    [ "$R_SIZE" != 0 ] && _sg_l2="${_sg_l2:+$_sg_l2  -  }$(fmt_size "$R_SIZE")"
+    [ -n "$R_REG" ] && _sg_l2="${_sg_l2:+$_sg_l2  -  }$R_REG"
+    if [ -n "$_sg_folder" ]; then _sg_dest="Roms/$_sg_folder"; else _sg_dest="?"; fi
+    if [ -n "$_sg_ex" ]; then _sg_dl="$L_DL_AGAIN"; else _sg_dl="$L_DL"; fi
+    _sg_c=$(ui_choose "$R_NAME${NL}$_sg_l2${NL}$L_DEST: $_sg_dest" \
+      "1. $_sg_dl" "2. $L_DL_FOLDER" "3. $L_DL_BACK")
+    case "$(choice_num "$_sg_c")" in
+    1)
+      if [ -z "$_sg_folder" ]; then
+        _sg_folder=$(plat_ask_folder "$R_PID" "$R_PSLUG" "$R_PFS")
+        if [ -z "$_sg_folder" ]; then
+          ui_notice "$L_NO_FOLDER"
+          continue
+        fi
+      fi
+      rom_download "$R_ID" "$R_FS" "$R_MULTI" "$R_FID" "$R_SIZE" "$_sg_folder" "$R_NAME"
+      _sg_rc=$?
+      ui_notice "$DL_MSG"
+      [ "$_sg_rc" = 0 ] && return 0
+      ;;
+    2)
+      _sg_nf=$(plat_ask_folder "$R_PID" "$R_PSLUG" "$R_PFS")
+      [ -n "$_sg_nf" ] && _sg_folder=$_sg_nf
+      ;;
+    *) return 0 ;;
+    esac
+  done
+}
+
+# ---------------------------------------------------------------- lista de jogos (paginada)
+screen_games() { # platform_id nome slug fs_slug busca
+  _gpid=$1
+  _gname=$2
+  _gslug=$3
+  _gfs=$4
+  _gq=$5
+  _goff=0
+  _gfetch=1
+  _gfolder=""
+  [ -n "$_gpid" ] && _gfolder=$(plat_folder "$_gpid" "$_gslug" "$_gfs")
+  while :; do
+    if [ "$_gfetch" = 1 ]; then
+      ui_info "$L_LOADING"
+      if ! roms_page "$_gpid" "$_gq" "$_goff" "$PAGE_SIZE"; then
+        ui_notice "$NET_ERR"
+        return 0
+      fi
+      _gfetch=0
+    fi
+    if [ "$ROMS_COUNT" -eq 0 ]; then
+      if [ "$_goff" -gt 0 ]; then
+        _goff=0
+        _gfetch=1
+        continue
+      fi
+      if [ -n "$_gq" ]; then ui_notice "$L_NO_RESULTS"; else ui_notice "$L_EMPTY_PAGE"; fi
+      return 0
+    fi
+
+    set --
+    set -- "$@" "$L_SEARCH"
+    [ -s "$TMPD/letters.tsv" ] && set -- "$@" "$L_LETTER"
+    _gn=0
+    while IFS=$US read -r _a _b _c _d _e _f _g _h _i _j _k; do
+      _gn=$((_gn + 1))
+      [ "$_h" = - ] && _h=""
+      [ "$_i" = - ] && _i=""
+      _gl=$_b
+      if [ -z "$_gpid" ]; then
+        [ "$_j" != - ] && _gl="$_gl [$_j]"
+        _gmf=$(plat_folder "$_g" "$_h" "$_i")
+      else
+        _gmf=$_gfolder
+      fi
+      if [ -n "$_gmf" ] && [ "$_e" != 1 ] && [ "$_d" != - ] &&
+        [ -f "$ROMS_DIR/$_gmf/$(dl_sanitize "$_d")" ]; then
+        _gl="* $_gl"
+      fi
+      set -- "$@" "$_gn. $_gl"
+    done <"$TMPD/page.tsv"
+    [ "$_goff" -gt 0 ] && set -- "$@" "$L_PREV"
+    [ "$ROMS_HASNEXT" = 1 ] && set -- "$@" "$L_NEXT"
+
+    _gfrom=$((_goff + 1))
+    _gto=$((_goff + ROMS_COUNT))
+    if [ -n "$ROMS_TOTAL" ]; then _grange="$_gfrom-$_gto $L_GAMES_FMT $ROMS_TOTAL"; else _grange="$_gfrom-$_gto"; fi
+    _gt="$_gname"
+    [ -n "$_gq" ] && _gt="$_gt: \"$_gq\""
+    _gc=$(ui_choose "$_gt  ($_grange)${NL}* = SD  |  $L_BACK_HINT" "$@")
+    [ -n "$_gc" ] || return 0
+
+    case "$_gc" in
+    "$L_NEXT")
+      _goff=$((_goff + PAGE_SIZE))
+      _gfetch=1
+      ;;
+    "$L_PREV")
+      _goff=$((_goff - PAGE_SIZE))
+      [ "$_goff" -lt 0 ] && _goff=0
+      _gfetch=1
+      ;;
+    "$L_SEARCH")
+      _gs=$(ui_input search "$_gq")
+      if [ -n "$_gs" ]; then
+        _gq=$_gs
+        _goff=0
+        _gfetch=1
+      fi
+      ;;
+    "$L_LETTER")
+      set --
+      while IFS=$US read -r _lk _lv; do
+        set -- "$@" "$_lk"
+      done <"$TMPD/letters.tsv"
+      _glc=$(ui_choose "$L_LETTER_TITLE" "$@")
+      if [ -n "$_glc" ]; then
+        _glo=$(awk -F"$US" -v k="$_glc" '$1 == k { print $2; exit }' "$TMPD/letters.tsv")
+        case "$_glo" in
+        '' | *[!0-9]*) : ;;
+        *)
+          _goff=$_glo
+          _gfetch=1
+          ;;
+        esac
+      fi
+      ;;
+    *)
+      row_load "$(choice_num "$_gc")"
+      screen_game
+      ;;
+    esac
+  done
+}
+
+screen_platforms() {
+  while :; do
+    if ! [ -s "$TMPD/platforms.tsv" ]; then
+      ui_info "$L_LOADING"
+      fetch_platforms || { ui_notice "$NET_ERR"; return 0; }
+    fi
+    [ -s "$TMPD/platforms.tsv" ] || { ui_notice "$L_NO_PLATFORMS"; return 0; }
+    set --
+    _pn=0
+    while IFS=$US read -r _pi _pname _pc _ps _pf; do
+      _pn=$((_pn + 1))
+      if [ "$_pc" = - ]; then set -- "$@" "$_pn. $_pname"; else set -- "$@" "$_pn. $_pname ($_pc)"; fi
+    done <"$TMPD/platforms.tsv"
+    _pch=$(ui_choose "$L_PLATFORMS_TITLE" "$@")
+    [ -n "$_pch" ] || return 0
+    awk -v n="$(choice_num "$_pch")" 'NR == n { print; exit }' "$TMPD/platforms.tsv" >"$TMPD/row.txt"
+    IFS=$US read -r P_ID P_NAME P_COUNT P_SLUG P_FS <"$TMPD/row.txt"
+    [ "$P_SLUG" = - ] && P_SLUG=""
+    [ "$P_FS" = - ] && P_FS=""
+    screen_games "$P_ID" "$P_NAME" "$P_SLUG" "$P_FS" ""
+  done
+}
+
+screen_search() {
+  _sq=$(ui_input search "")
+  [ -n "$_sq" ] || return 0
+  screen_games "" "$L_SEARCH_RESULTS" "" "" "$_sq"
+}
+
+# ---------------------------------------------------------------- login / servidor
+ask_server() {
+  _as=$(cfg_get base_url)
+  [ -n "$_as" ] || _as="http://"
+  _av=$(ui_input url "$_as")
+  [ -n "$_av" ] || return 1
+  _av=$(net_normalize_url "$_av") || return 1
+  cfg_set base_url "$_av"
+}
+
+ask_auth() {
+  _aa=$(ui_choose "$L_AUTH_TITLE" "1. $L_AUTH_USER" "2. $L_AUTH_TOKEN")
+  case "$(choice_num "$_aa")" in
+  1)
+    _au=$(ui_input user "$(cfg_get username)")
+    [ -n "$_au" ] || return 1
+    _ap=$(ui_input pass "" pw)
+    cfg_set username "$_au"
+    cfg_set password "$_ap"
+    cfg_set token ""
+    ;;
+  2)
+    _at=$(ui_input token "$(cfg_get token)")
+    [ -n "$_at" ] || return 1
+    cfg_set token "$_at"
+    cfg_set username ""
+    cfg_set password ""
+    ;;
+  *) return 1 ;;
+  esac
+  return 0
+}
+
+connect_report() { # tenta conectar; mostra o resultado. 0 = conectou
+  net_init
+  rm -f "$TMPD/platforms.tsv"
+  ui_info "$L_CONNECTING"
+  if net_connect; then
+    return 0
+  fi
+  return 1
+}
+
+wizard() {
+  _wk=$(ui_wait "$L_WIZ_WELCOME" "A B")
+  [ "$_wk" = A ] || return 1
+  ask_server || return 1
+  ask_auth || return 1
+  while :; do
+    if connect_report; then
+      ui_notice "$L_TEST_OK${NL}RomM ${NET_VERSION:-?}${NL}$PLATFORM_COUNT $L_TEST_PLAT"
+      return 0
+    fi
+    _wc=$(ui_choose "$L_CONN_ERR_TITLE${NL}$NET_ERR" \
+      "1. $L_RETRY" "2. $L_EDIT_SERVER" "3. $L_EDIT_LOGIN" "4. $L_EXIT")
+    case "$(choice_num "$_wc")" in
+    1) : ;;
+    2) ask_server ;;
+    3) ask_auth ;;
+    *) return 1 ;;
+    esac
+  done
+}
+
+startup_check() { # conecta ao abrir o app; se falhar, oferece tentar de novo / configuracoes / sair
+  while :; do
+    if connect_report; then return 0; fi
+    _sc=$(ui_choose "$L_CONN_ERR_TITLE${NL}$NET_ERR" \
+      "1. $L_RETRY" "2. $L_MAIN_SETTINGS" "3. $L_EXIT")
+    case "$(choice_num "$_sc")" in
+    1) : ;;
+    2) screen_settings ;;
+    *) return 1 ;;
+    esac
+  done
+}
+
+# ---------------------------------------------------------------- configuracoes
+settings_test() {
+  if connect_report; then
+    _st_ts=$(ts_state)
+    case "$_st_ts" in running*) _st_ts="$L_TS_UP (${_st_ts#running })" ;; *) _st_ts="" ;; esac
+    ui_notice "$L_TEST_OK${NL}RomM ${NET_VERSION:-?}${NL}$PLATFORM_COUNT $L_TEST_PLAT${NL}$_st_ts"
+  else
+    ui_notice "$L_CONN_ERR_TITLE${NL}$NET_ERR"
+  fi
+}
+
+screen_about() {
+  _ab_ts=$(ts_state)
+  ui_notice "RomM Library $APP_VERSION${NL}$L_ABOUT_SRV: ${NET_VERSION:-?}${NL}Tailscale: ${_ab_ts%% *}${NL}$L_ABOUT_CFG: Data/romm/config.json${NL}$L_ABOUT_LOG: System/logs/romm_library.log"
+}
+
+screen_settings() {
+  while :; do
+    _ss_srv=$(cfg_get base_url)
+    if [ -n "$(cfg_get token)" ]; then _ss_login="$L_S_LOGIN_TOKEN"; else _ss_login=$(cfg_get username); fi
+    if [ "$(cfg_get insecure)" = 1 ]; then _ss_ins="$L_ON"; else _ss_ins="$L_OFF"; fi
+    _ss_c=$(ui_choose "$L_SETTINGS  ($L_BACK_HINT)" \
+      "1. $L_S_SERVER: $_ss_srv" "2. $L_S_LOGIN: $_ss_login" "3. $L_S_TEST" \
+      "4. $L_S_PAGE: $PAGE_SIZE" "5. $L_S_LANG: $LANG_UI" "6. $L_S_INSECURE: $_ss_ins" \
+      "7. $L_S_FOLDERS" "8. $L_S_PARTS" "9. $L_S_ABOUT")
+    case "$(choice_num "$_ss_c")" in
+    1) ask_server && settings_test ;;
+    2) ask_auth && settings_test ;;
+    3) settings_test ;;
+    4)
+      case "$PAGE_SIZE" in
+      20) _ss_n=30 ;;
+      30) _ss_n=50 ;;
+      50) _ss_n=100 ;;
+      *) _ss_n=20 ;;
+      esac
+      cfg_set page_size "$_ss_n"
+      PAGE_SIZE=$_ss_n
+      ;;
+    5)
+      if [ "$LANG_UI" = en ]; then cfg_set lang pt; else cfg_set lang en; fi
+      load_settings
+      ;;
+    6)
+      if [ "$(cfg_get insecure)" = 1 ]; then cfg_set insecure 0; else cfg_set insecure 1; fi
+      net_init
+      ;;
+    7)
+      map_clear
+      ui_notice "$L_FOLDERS_CLEARED"
+      ;;
+    8)
+      _ss_k=$(dl_clean_parts)
+      if [ "$_ss_k" = 0 ]; then ui_notice "$L_PARTS_NONE"; else ui_notice "$L_PARTS_DONE $_ss_k"; fi
+      ;;
+    9) screen_about ;;
+    *) return 0 ;;
+    esac
+  done
+}
+
+# ---------------------------------------------------------------- menu principal e entrada
+screen_main() {
+  while :; do
+    _mc=$(ui_choose "$L_MAIN_TITLE" "1. $L_MAIN_BROWSE" "2. $L_MAIN_SEARCH" \
+      "3. $L_MAIN_SETTINGS" "4. $L_MAIN_EXIT")
+    case "$(choice_num "$_mc")" in
+    1) screen_platforms ;;
+    2) screen_search ;;
+    3) screen_settings ;;
+    4 | "") return 0 ;;
+    esac
+  done
+}
+
+app_main() {
+  tmp_init
+  lang_load pt
+  if [ -z "$JQ" ] || [ -z "$CURL" ]; then
+    log "faltam ferramentas: jq='$JQ' curl='$CURL'"
+    ui_notice "$L_NEED_TOOLS"
+    return 1
+  fi
+  mkdir -p "$DATA_DIR" 2>/dev/null
+  if [ -s "$CFG" ] && ! cfg_valid; then
+    mv -f "$CFG" "$CFG.bad" 2>/dev/null
+    log "config.json invalido: guardado como config.json.bad"
+  fi
+  load_settings
+  if [ -z "$(cfg_get base_url)" ]; then
+    wizard || return 0
+  fi
+  net_init
+  if [ -n "$(cfg_get base_url)" ] && ! [ -s "$TMPD/platforms.tsv" ]; then
+    startup_check || return 0
+  fi
+  screen_main
+  return 0
+}
