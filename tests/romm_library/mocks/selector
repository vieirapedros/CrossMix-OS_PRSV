#!/bin/sh
# mock do selector: escolhe segundo a fila $MOCK_DIR/sel.q  (contains:X | exact:X | idx:N | cancel)
# Os textos chegam em Latin-1 (como no aparelho); os logs saem em UTF-8 para os testes poderem usar grep.
# Um menu de UM item "OK" e' um aviso (ui_notice/ui_wait): vai para info.log e responde pela fila info.q (padrao A).
. "$(dirname "$0")/mocklib.sh"
D=$MOCK_DIR
title=""
while [ $# -gt 0 ]; do
  case "$1" in
  -t) title=$2; shift 2 ;;
  -fs | -i | -d) shift 2 ;;
  -c) shift; break ;;
  *) shift ;;
  esac
done
u8() { # texto -> UTF-8 (se ja for UTF-8 valido, fica como esta; senao le como Latin-1)
  if printf '%s' "$1" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1; then printf '%s' "$1"
  else printf '%s' "$1" | iconv -f ISO-8859-1 -t UTF-8; fi
}
tu=$(u8 "$title")
{ printf '=== %s\n' "$title"; for it in "$@"; do printf '  | %s\n' "$it"; done; } >>"$D/sel.raw"
if [ $# -eq 1 ] && [ "$(u8 "$1")" = OK ]; then
  # aviso: o titulo traz "\n" literal; no log vira quebra de linha real (como o selector desenha)
  printf '%s\n----\n' "$title" | sed 's/\\n/\n/g' >>"$D/info.raw"
  printf '%s\n----\n' "$tu" | sed 's/\\n/\n/g' >>"$D/info.log"
  act=$(pop "$D/info.q")
  case "$act" in key:B) exit 0 ;; *) printf 'You selected: %s\n' "$1" ;; esac
  exit 0
fi
{ printf '=== %s\n' "$tu"; for it in "$@"; do printf '  | %s\n' "$(u8 "$it")"; done; } >>"$D/sel.log"
act=$(pop "$D/sel.q")
chosen=""
want=${act#*:}
i=0
for it in "$@"; do
  i=$((i + 1))
  iu=$(u8 "$it")
  case "$act" in
  contains:*) case "$iu" in *"$want"*) chosen=$it; chosen_u=$iu; break ;; esac ;;
  exact:*) [ "$iu" = "$want" ] && { chosen=$it; chosen_u=$iu; break; } ;;
  idx:*) [ "$i" = "$want" ] && { chosen=$it; chosen_u=$iu; break; } ;;
  esac
done
case "$act" in cancel | "") ;; *) [ -n "$chosen" ] || echo "SELECTOR sem item para '$act' em '$tu'" >>"$D/errors.log" ;; esac
printf 'ACT %s -> %s\n' "${act:-<fila vazia>}" "${chosen_u:-<cancelou>}" >>"$D/sel.log"
[ -n "$chosen" ] && printf 'You selected: %s\n' "$chosen"
exit 0
